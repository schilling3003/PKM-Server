# PKM v1 local environment
# These are local-development defaults. Copy to `.env` and change values
# before using this file outside a disposable local environment.
NODE_ENV=development

# Database
POSTGRES_USER=pkm
POSTGRES_PASSWORD=pkm
DATABASE_URL=postgresql://pkm:pkm@localhost:5432/pkm?schema=public
# TEST_DATABASE_URL is auto-derived as pkm_test if omitted. Set it explicitly if you use a non-standard name.

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pkm
S3_REGION=us-east-1

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-ai-key-change-in-production
# Optional: configure an OpenAI-compatible LLM for /ask synthesized answers.
# When unset, /ask returns a grounded note list instead of calling a model.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=30

# Temporal
TEMPORAL_HOST=localhost:7233

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SESSION_SECRET=dev-secret-change-me-before-deploying

# OIDC (placeholder abstraction)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/oidc
