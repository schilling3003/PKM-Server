# PKM v1 local environment
# These are local-development defaults. Copy to `.env` and change values
# before using this file outside a disposable local environment.
NODE_ENV=development

# Database
POSTGRES_USER=pkm
POSTGRES_PASSWORD=pkm
DATABASE_URL=postgresql://pkm:pkm@localhost:5432/pkm?schema=public
# TEST_DATABASE_URL is auto-derived as pkm_test if omitted. Set it explicitly if you use a non-standard name.

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pkm
S3_REGION=us-east-1

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-ai-key-change-in-production
# Optional: configure an OpenAI-compatible LLM for synthesized answers and KG extraction.
# When unset, /ask returns grounded note snippets and indexing skips KG extraction (process_options="F!").
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=30

# Embedding provider for semantic search and LightRAG vector storage.
# `EMBEDDING_PROVIDER=openai` calls an OpenAI-compatible /v1/embeddings endpoint.
# `EMBEDDING_PROVIDER=sentence-transformers` loads the local model configured below.
# `EMBEDDING_PROVIDER=stub` returns deterministic vectors (useful for tests and no-model fallback).
EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# LightRAG scratch directory. Postgres is the authoritative storage; this path
# holds transient per-workspace caches only.
LIGHTRAG_WORKING_DIR=/tmp/lightrag

# Temporal
TEMPORAL_HOST=localhost:7233

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Set TRUST_PROXY=true when the API is behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false
SESSION_SECRET=dev-secret-change-me-before-deploying

# Rate limits (optional). Defaults are generous for local development.
# RATE_LIMIT_AUTH_IP_MAX=10
# RATE_LIMIT_AUTH_ACCOUNT_MAX=5
# RATE_LIMIT_SEARCH_IP_MAX=120
# RATE_LIMIT_SEARCH_ACCOUNT_MAX=60
# RATE_LIMIT_ASK_IP_MAX=60
# RATE_LIMIT_ASK_ACCOUNT_MAX=30
# RATE_LIMIT_ATTACHMENTS_IP_MAX=60
# RATE_LIMIT_ATTACHMENTS_ACCOUNT_MAX=30

# OIDC (placeholder abstraction)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/oidc
