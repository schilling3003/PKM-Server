# PKM v1 local environment
# These are local-development defaults. Copy to `.env` and change values
# before using this file outside a disposable local environment.
NODE_ENV=development

# Database
POSTGRES_USER=pkm
POSTGRES_PASSWORD=pkm
DATABASE_URL=postgresql://pkm:pkm@localhost:5432/pkm?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pkm
S3_REGION=us-east-1

# AI service
AI_SERVICE_URL=http://localhost:8000

# Temporal
TEMPORAL_HOST=localhost:7233

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SESSION_SECRET=dev-secret-change-me-before-deploying

# OIDC (placeholder abstraction)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/oidc
